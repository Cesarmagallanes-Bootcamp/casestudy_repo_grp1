<mvc:View
    controllerName="sapips.training.casestudygrp1.controller.DetailPage"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true"
>
    <Page
        id="detailPage"
        title="Order Management"
        showNavButton="true"
        navButtonPress="onNavBack"
    >
        <content>
            <VBox id="_IDGenVBox5" class="sapUiSmallMargin">
                <!-- Order Detail Fragment -->
                <core:Fragment
                    fragmentName="sapips.training.casestudygrp1.fragment.OrderDetailForm"
                    type="XML"
                />

                <!-- Product Table Fragment -->
                <core:Fragment
                    fragmentName="sapips.training.casestudygrp1.fragment.ProductTable"
                    type="XML"
                />
            </VBox>
        </content>

        <footer>
            <Toolbar id="_IDGenToolbar1">
                <ToolbarSpacer id="_IDGenToolbarSpacer1" />
                <Button id="_IDGenButton5"
                    text="Edit"
                    type="Emphasized"
                    press="onEdit"
                />
                <Button id="_IDGenButton6"
                    text="Cancel"
                    press="onNavBack"
                />
            </Toolbar>
        </footer>
    </Page>
</mvc:View>
