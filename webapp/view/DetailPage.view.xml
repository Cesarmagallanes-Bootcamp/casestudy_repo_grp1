<mvc:View
    controllerName="sapips.training.casestudygrp1.controller.DetailPage"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true"
>
    <Page
        id="detailPage"
        title="{i18n>title}"
        showNavButton="true"
        navButtonPress="onNavBack"
    >
        <content>
            <VBox id="_OrderDetailBox" class="sapUiSmallMargin">
                <!-- Order Detail Fragment -->
                <core:Fragment
                    fragmentName="sapips.training.casestudygrp1.fragment.OrderDetailForm"
                    type="XML"
                />

                <!-- Product Table Fragment -->
                <core:Fragment
                    fragmentName="sapips.training.casestudygrp1.fragment.ProductTable"
                    type="XML"
                />
            </VBox>
        </content>

        <footer>
            <Toolbar id="_FooterToolbar">
                <ToolbarSpacer id="_ToolbarSpacer" />
                <Button id="_EditButton"
                    text="{i18n>edit}"
                    type="Emphasized"
                    press="onEdit"
                />
                <Button id="_CancelButton"
                    text="{i18n>cancel}"
                    press="onNavBack"
                />
            </Toolbar>
        </footer>
    </Page>
</mvc:View>
