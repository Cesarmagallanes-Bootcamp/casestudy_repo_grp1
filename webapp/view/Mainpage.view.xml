<mvc:View
    controllerName="sapips.training.casestudygrp1.controller.Mainpage"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page id="_IDGenPage" title="Order Management">

        <content>
            <VBox id="_IDGenVBox" class="sapUiSmallMargin">

                <!-- Filters -->
                <l:Grid id="_IDGenGrid"
                    defaultSpan="L4 M4 S12"
                    class="sapUiSmallMarginBottom">

                    <l:content>

                        <VBox id="_IDGenVBox1">
                            <Label id="_IDGenLabel" text="Order Number"/>
                            <Input
                                id="filterOrderNumber"
                                placeholder="Order Number"/>
                        </VBox>

                        <VBox id="_IDGenVBox2">
                            <Label id="_IDGenLabel1" text="Creation Date"/>
                            <DatePicker
                                id="filterCreationDate"
                                valueFormat="yyyy-MM-dd"
                                displayFormat="dd MMM yyyy"/>
                        </VBox>

                        <VBox id="_IDGenVBox3">
                            <Label id="_IDGenLabel2" text="Status"/>
                            <MultiComboBox id="filterStatus">
                                <items>
                                    <core:Item id="_IDGenItem" key="Created" text="Created"/>
                                    <core:Item id="_IDGenItem1" key="Released" text="Released"/>
                                    <core:Item id="_IDGenItem2" key="Partially Completed" text="Partially Completed"/>
                                    <core:Item id="_IDGenItem3" key="Delivered" text="Delivered"/>
                                </items>
                            </MultiComboBox>
                        </VBox>

                    </l:content>
                </l:Grid>

                <!-- Buttons -->
                <HBox id="_IDGenHBox"
                    justifyContent="End"
                    class="sapUiSmallMarginBottom">

                    <Button id="_IDGenButton"
                        text="Go"
                        type="Emphasized"
                        press="onSearch"
                        class="sapUiSmallMarginEnd"/>

                    <Button id="_IDGenButton1"
                        text="Clear"
                        press="onClear"/>
                        
                </HBox>

                <!-- Table -->
                <Table
                    id="ordersTable"
                    items="{/Orders}"
                    mode="MultiSelect"
                    growing="true"
                    growingThreshold="10">

                    <headerToolbar>
                        <Toolbar id="_IDGenToolbar">
                            <Title
                                id="tableTitle"
                                text="Orders (0)"/>
                            <ToolbarSpacer id="_IDGenToolbarSpacer"/>
                            <Button id="_IDGenButton2"
                                icon="sap-icon://add"
                                press="onCreateOrder"/>
                            <Button id="_IDGenButton3"
                                icon="sap-icon://delete"
                                press="onDeleteOrder"/>
                        </Toolbar>
                    </headerToolbar>

                    <columns>
                        <Column id="_IDGenColumn"><Text id="_IDGenText1" text="Order Number"/></Column>
                        <Column id="_IDGenColumn1"><Text id="_IDGenText2" text="Creation Date"/></Column>
                        <Column id="_IDGenColumn2"><Text id="_IDGenText3" text="Receiving Plant"/></Column>
                        <Column id="_IDGenColumn3"><Text id="_IDGenText4" text="Delivering Plant"/></Column>
                        <Column id="_IDGenColumn4"><Text id="_IDGenText5" text="Status"/></Column>
                        <Column id="_IDGenColumn5"/>
                    </columns>

                    <items>
                        <ColumnListItem id="_IDGenColumnListItem"
                            type="Navigation"
                            press="onOrderPress">

                            <cells>

                                <Text id="_IDGenText6" text="{OrderNumber}"/>
                                <Text id="_IDGenText7" text="{CreationDate}"/>
                                <Text id="_IDGenText8" text="{ReceivingPlant} - {ReceivingPlantDesc}"/>
                                <Text id="_IDGenText9" text="{DeliveringPlant} - {DeliveringPlantDesc}"/>

                                <ObjectStatus id="_IDGenObjectStatus"
                                    text="{Status}"
                                    state="{= ${Status} === 'Created' ? 'Information' :
                                           ${Status} === 'Released' ? 'Warning' :
                                           ${Status} === 'Partially Completed' ? 'Error' :
                                           ${Status} === 'Delivered' ? 'Success' : 'None'}"/>

                                <Button id="_IDGenButton4"
                                    type="Transparent"
                                    icon="sap-icon://navigation-right"
                                    press="onOrderPress"/>

                            </cells>

                        </ColumnListItem>
                    </items>

                </Table>

            </VBox>
        </content>

    </Page>

</mvc:View>
