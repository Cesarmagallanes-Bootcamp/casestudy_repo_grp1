<mvc:View
    controllerName="sapips.training.casestudygrp1.controller.Mainpage"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page id="_IDGenPage" title="{i18n>title}">

        <content>
            <VBox id="_MainPageBox" class="sapUiSmallMargin">

                <!-- Filters -->
                <l:Grid id="_FilterGrid"
                    defaultSpan="L4 M4 S12"
                    class="sapUiSmallMarginBottom">

                    <l:content>

                        <VBox id="_FilterVBox1">
                            <Label id="_FilterLabel" text="{i18n>orderNumber}"/>
                            <Input
                                id="filterOrderNumber"
                                placeholder="{i18n>orderNumber}"/>
                        </VBox>

                        <VBox id="_FilterVBox2">
                            <Label id="_FilterLabel1" text="{i18n>creationDate}"/>
                            <DatePicker
                                id="filterCreationDate"
                                valueFormat="yyyy-MM-dd"
                                displayFormat="dd MMM yyyy"/>
                        </VBox>

                        <VBox id="_FilterVBox3">
                            <Label id="_FilterLabel2" text="{i18n>status}"/>
                            <MultiComboBox id="filterStatus">
                                <items>
                                    <core:Item id="_createdItem" key="Created" text="{i18n>createdTxt}"/>
                                    <core:Item id="_releasedItem" key="Released" text="{i18n>releasedTxt}"/>
                                    <core:Item id="_partiallyCompletedItem" key="Partially Completed" text="{i18n>completedTxt}"/>
                                    <core:Item id="_deliveredItem" key="Delivered" text="{i18n>deliveredTxt}"/>
                                </items>
                            </MultiComboBox>
                        </VBox>

                    </l:content>
                </l:Grid>

                <!-- Buttons -->
                <HBox id="_ButtonsHBox"
                    justifyContent="End"
                    class="sapUiSmallMarginBottom">

                    <Button id="_GoButton"
                        text="{i18n>goBtn}"
                        type="Emphasized"
                        press="onSearch"
                        class="sapUiSmallMarginEnd"/>

                    <Button id="_ClearButton"
                        text="{i18n>clearBtn}"
                        press="onClear"/>
                        
                </HBox>

                <!-- Table -->
                <Table
                    id="ordersTable"
                    items="{/Orders}"
                    mode="MultiSelect"
                    growing="true"
                    growingThreshold="10">

                    <headerToolbar>
                        <Toolbar id="_CreateAndDeleteToolbar">
                            <Title
                                id="tableTitle"
                                text="Orders (0)"/>
                            <ToolbarSpacer id="_IDGenToolbarSpacer"/>
                            <Button id="_CreateButton"
                                icon="sap-icon://add"
                                press="onCreateOrder"/>
                            <Button id="_DeleteButton"
                                icon="sap-icon://delete"
                                press="onDeleteOrder"/>
                        </Toolbar>
                    </headerToolbar>

                    <columns>
                        <Column id="_OrderNumberColumn"><Text id="_IDGenText1" text="{i18n>orderNum}"/></Column>
                        <Column id="_CreationDateColumn"><Text id="_IDGenText2" text="{i18n>creationDate}"/></Column>
                        <Column id="_ReceivingPlantColumn"><Text id="_IDGenText3" text="{i18n>receivePlant}"/></Column>
                        <Column id="_DeliveringPlantColumn"><Text id="_IDGenText4" text="{i18n>delivPlant}"/></Column>
                        <Column id="_StatusColumn"><Text id="_IDGenText5" text="{i18n>status}"/></Column>
                        <Column id="_ExtraColumn"/>
                    </columns>

                    <items>
                        <ColumnListItem id="_ColumnListItem"
                            type="Navigation"
                            press="onOrderPress">

                            <cells>

                                <Text id="_OrderNumberText" text="{OrderNumber}"/>
                                <Text id="_CreationDateText" text="{CreationDate}"/>
                                <Text id="_ReceivingPlantText" text="{ReceivingPlant} - {ReceivingPlantDesc}"/>
                                <Text id="_DeliveringPlantText" text="{DeliveringPlant} - {DeliveringPlantDesc}"/>

                                <ObjectStatus id="_IDGenObjectStatus"
                                    text="{Status}"
                                    state="{= ${Status} === 'Created' ? 'Information' :
                                           ${Status} === 'Released' ? 'Warning' :
                                           ${Status} === 'Partially Completed' ? 'Error' :
                                           ${Status} === 'Delivered' ? 'Success' : 'None'}"/>

                                <Button id="_IDGenButton4"
                                    type="Transparent"
                                    icon="sap-icon://navigation-right"
                                    press="onOrderPress"/>

                            </cells>

                        </ColumnListItem>
                    </items>

                </Table>

            </VBox>
        </content>

    </Page>

</mvc:View>
