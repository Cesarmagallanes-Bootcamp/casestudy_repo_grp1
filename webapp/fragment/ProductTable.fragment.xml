<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Panel id="_IDGenPanel1" class="sapUiSmallMarginBottom">

        <!-- Header -->
        <headerToolbar>
            <Toolbar id="_IDGenToolbar2">
                <Title
                    id="productTableTitle"
                    text="Product (0)" />
            </Toolbar>
        </headerToolbar>

        <!-- Product Table -->
        <Table
            id="productTable"
            items="{products>/}"
            growing="true"
            growingThreshold="10">

            <columns>
                <Column id="_IDGenColumn6">
                    <Text id="_IDGenText10" text="Product Name" />
                </Column>
                <Column id="_IDGenColumn7">
                    <Text id="_IDGenText11" text="Quantity" />
                </Column>
                <Column id="_IDGenColumn8">
                    <Text id="_IDGenText12" text="Price Per Quantity" />
                </Column>
                <Column id="_IDGenColumn9">
                    <Text id="_IDGenText13" text="Total Price" />
                </Column>
            </columns>

            <items>
                <ColumnListItem id="_IDGenColumnListItem1">
                    <cells>

                        <Text id="_IDGenText14"
                            text="{products>ProductCode} - {products>ProductName}" />

                        <Text id="_IDGenText15"
                            text="{products>Quantity}" />

                        <Text id="_IDGenText16"
                            text="{products>PricePerQuantity}" />

                        <Text id="_IDGenText17"
                            text="{products>TotalPrice}" />

                    </cells>
                </ColumnListItem>
            </items>

        </Table>

    </Panel>

</core:FragmentDefinition>
