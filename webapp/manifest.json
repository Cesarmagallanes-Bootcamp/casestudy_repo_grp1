{
  "_version": "1.84.0",
  "sap.app": {
    "id": "sapips.training.casestudygrp1",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json"
  },

  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },

  "sap.ui5": {
    "flexEnabled": true,

    "dependencies": {
      "minUI5Version": "1.148.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },

    "contentDensities": {
      "compact": true,
      "cozy": true
    },

    "models": {
      "": {
        "type": "sap.ui.model.json.JSONModel",
        "uri": "model/mockData.json"
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "sapips.training.casestudygrp1.i18n.i18n"
        }
      }
    },

    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlId": "app",
        "controlAggregation": "pages",
        "viewType": "XML",
        "viewPath": "sapips.training.casestudygrp1.view",
        "async": true
      },

      "routes": [
        {
          "name": "MainPage",
          "pattern": "",
          "target": "MainPage"
        },
        {
          "name": "CreatePage",
          "pattern": "create",
          "target": "CreatePage"
        },
        {
          "name": "DetailPage",
          "pattern": "detail/{orderIndex}",
          "target": "DetailPage"
        },
        {
          "name": "EditPage",
          "pattern": "edit/{orderIndex}",
          "target": "EditPage"
        }
      ],

      "targets": {
        "MainPage": {
          "viewName": "Mainpage",
          "viewLevel": 1
        },
        "CreatePage": {
          "viewName": "CreatePage",
          "viewLevel": 2
        },
        "DetailPage": {
          "viewName": "DetailPage",
          "viewLevel": 2
        },
        "EditPage": {
          "viewName": "EditPage",
          "viewLevel": 3
        }
      }
    },

    "rootView": {
      "viewName": "sapips.training.casestudygrp1.view.App",
      "type": "XML",
      "id": "app",
      "async": true
    }
  }
}